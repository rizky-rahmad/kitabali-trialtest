# ─── Runtime ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ─── Database ──────────────────────────────────────────────
# Either a full connection string...
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bookings_db
# ...set to "true" if your Postgres requires SSL (most managed providers do)
PGSSL=false

# ─── Auth ──────────────────────────────────────────────────
# Shared secret required by GET /api/admin/bookings (sent as x-admin-key header)
ADMIN_KEY=change-me-to-a-long-random-string

# ─── CORS ──────────────────────────────────────────────────
# Set to your Cloudflare Pages URL once deployed, e.g.:
#   CORS_ORIGINS=https://thisbali-frontend.pages.dev
# Use "*" only while developing.
CORS_ORIGINS=*

# ─── Rate limiting (optional; sensible defaults applied) ───
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
BOOKING_RATE_LIMIT_MAX=10
